+++ b/src/collective/eeafaceted/collectionwidget/profiles/plone6/registry.xml
@@ -0,0 +1,37 @@
+<?xml version="1.0"?>
+<registry>
+
+  <!-- Plone 6 loads scripts and styles from these bundle records. -->
+  <records prefix="plone.bundles/faceted-collectionwidget"
+           interface="Products.CMFPlone.interfaces.IBundleRegistry">
+    <value key="enabled">True</value>
+    <value key="depends">plone</value>
+    <value key="jscompilation"></value>
+    <value key="csscompilation">++resource++collective.eeafaceted.collectionwidget/collective.eeafaceted.collectionwidget.css</value>
+    <value key="load_defer">False</value>
+    <value key="load_async">False</value>
+  </records>
+
+  <!-- The collection widget view script registers the widget in Faceted.Widgets.
+       It must load after the faceted view script. -->
+  <records prefix="plone.bundles/faceted-collectionwidget-view"
+           interface="Products.CMFPlone.interfaces.IBundleRegistry">
+    <value key="enabled">True</value>
+    <value key="depends">faceted.view</value>
+    <value key="jscompilation">++resource++collective.eeafaceted.collectionwidget.widgets.view.js</value>
+    <value key="csscompilation">++resource++collective.eeafaceted.collectionwidget.view.css</value>
+    <value key="load_defer">False</value>
+    <value key="load_async">False</value>
+  </records>
+
+  <records prefix="plone.bundles/faceted-collectionwidget-edit"
+           interface="Products.CMFPlone.interfaces.IBundleRegistry">
+    <value key="enabled">True</value>
+    <value key="depends">faceted.edit</value>
+    <value key="jscompilation">++resource++collective.eeafaceted.collectionwidget.widgets.edit.js</value>
+    <value key="csscompilation">++resource++collective.eeafaceted.collectionwidget.edit.css</value>
+    <value key="load_defer">False</value>
+    <value key="load_async">False</value>
+  </records>
+
+</registry>
