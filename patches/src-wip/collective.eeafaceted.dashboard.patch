diff --git a/src/collective/eeafaceted/dashboard/profiles/plone6/registry.xml b/src/collective/eeafaceted/dashboard/profiles/plone6/registry.xml
new file mode 100644
index 0000000..a4a4a46
--- /dev/null
+++ b/src/collective/eeafaceted/dashboard/profiles/plone6/registry.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0"?>
+<registry>
+
+  <!-- Plone 6 loads scripts and styles from these bundle records.
+       The dashboard script uses Faceted and the z3ctable script. -->
+  <records prefix="plone.bundles/faceted-dashboard"
+           interface="Products.CMFPlone.interfaces.IBundleRegistry">
+    <value key="enabled">True</value>
+    <value key="depends">faceted.view,faceted-z3ctable</value>
+    <value key="jscompilation">++resource++collective.eeafaceted.dashboard/collective.eeafaceted.dashboard.js</value>
+    <value key="csscompilation">++resource++collective.eeafaceted.dashboard/collective.eeafaceted.dashboard.css</value>
+    <value key="load_defer">False</value>
+    <value key="load_async">False</value>
+  </records>
+
+</registry>
