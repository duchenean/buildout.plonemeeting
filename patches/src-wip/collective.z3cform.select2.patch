--- /dev/null
+++ b/src/collective/z3cform/select2/profiles/plone6/registry.xml
@@ -0,0 +1,25 @@
+<?xml version="1.0"?>
+<registry>
+
+<!-- Plone 6 loads scripts and styles from these bundle records.
+     The select2 library comes from the ftw.labels bundle. -->
+  <records prefix="plone.bundles/select2-widget"
+           interface="Products.CMFPlone.interfaces.IBundleRegistry">
+    <value key="enabled">True</value>
+    <value key="depends">ftw-labels-select2</value>
+    <value key="jscompilation">++resource++select2-widget/select2-widget.js</value>
+    <value key="csscompilation">++resource++select2-widget/select2-widget.css</value>
+    <value key="load_defer">False</value>
+    <value key="load_async">False</value>
+  </records>
+  <records prefix="plone.bundles/faceted-select2-view"
+           interface="Products.CMFPlone.interfaces.IBundleRegistry">
+    <value key="enabled">True</value>
+    <value key="depends">faceted.view,select2-widget</value>
+    <value key="jscompilation">++resource++faceted.select2.view.js</value>
+    <value key="csscompilation"></value>
+    <value key="load_defer">False</value>
+    <value key="load_async">False</value>
+  </records>
+
+</registry>
