diff --git a/src/imio/actionspanel/browser/views.py b/src/imio/actionspanel/browser/views.py
index 92dd26f..435759c 100644
--- a/src/imio/actionspanel/browser/views.py
+++ b/src/imio/actionspanel/browser/views.py
@@ -582,11 +582,17 @@ class ActionsPanelView(BrowserView):
                 # path including portal_url or so, just take care that we do not have
                 # an image in a static resource folder
                 splittedIconPath = act['icon'].split('/')
-                if len(splittedIconPath) > 1 and '++resource++' in splittedIconPath[-2]:
-                    # keep last 2 parts of the path
+                if len(splittedIconPath) > 1 and (
+                        '++resource++' in splittedIconPath[-2] or
+                        splittedIconPath[-2].startswith('++plone++')):
+                    # keep last 2 parts of the path, the image is in a
+                    # browser resource directory or a Plone 6 static directory
                     act['icon'] = '/'.join((splittedIconPath[-2], splittedIconPath[-1], ))
                 else:
                     act['icon'] = splittedIconPath[-1]
+                if '.' not in act['icon']:
+                    # a Plone 6 icon name, the icon resolver serves it
+                    act['icon'] = '@@iconresolver/{0}'.format(act['icon'])
             res.append(act)
         return res
 
